{
  "name": "ezy-core-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build": "storybook build --disable-telemetry",
    "test": "test-storybook --url http://127.0.0.1:6006 --maxWorkers=2",
    "test:ci": "start-server-and-test 'http-server storybook-static -a 127.0.0.1 -p 6006 --silent' http://127.0.0.1:6006 test",
    "browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.29.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-webpack5-compiler-babel": "4.0.1",
    "@storybook/react-webpack5": "10.6.2",
    "@storybook/test-runner": "0.26.0",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "http-server": "^14.1.1",
    "playwright": "^1.56.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "1.92.1",
    "sass-loader": "^16.0.5",
    "start-server-and-test": "^2.1.0",
    "storybook": "10.6.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.106.2"
  }
}
